# Telegram
BOT_TOKEN=123456:ABC-your-bot-token
# Любая длинная случайная строка. Тем же значением регистрируется webhook.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Провайдер курсов: oxr (по умолчанию) | frankfurter
RATES_PROVIDER=oxr
# Нужен только при RATES_PROVIDER=oxr. Ключ: https://openexchangerates.org/signup/free
OXR_APP_ID=your-open-exchange-rates-app-id

# Локально
PORT=3000

# Только для скрипта set-webhook (не читается приложением)
# WEBHOOK_URL=https://your-app.vercel.app/webhook
